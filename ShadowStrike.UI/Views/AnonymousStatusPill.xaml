<UserControl x:Class="ShadowStrike.UI.Views.AnonymousStatusPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Border x:Name="PillBorder" CornerRadius="12" Padding="8,3" Background="#1C2333" BorderBrush="#30363D" BorderThickness="1">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#8899A6" Margin="0,0,6,0" />
            <TextBlock x:Name="StatusText" Text="ANONYMOUS: OFF" FontSize="11" FontWeight="SemiBold" Foreground="#8899A6" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
